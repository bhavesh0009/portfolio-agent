# Screener.in Credentials
SCREENER_EMAIL=your_email@example.com
SCREENER_PASSWORD=your_password_here

# Gemini API Configuration
GEMINI_API_KEY=Your_Gemini_API_Key_Here

# Gemini Model Tiers (cost-performance optimization)
# HIGH: Complex reasoning for portfolio orchestrators (e.g., gemini-2.5-pro)
# MID: Balanced performance for analysis agents (e.g., gemini-2.5-flash) - Default
# LOW: Fast, lightweight for simple tasks (e.g., gemini-2.5-flash-lite)
GEMINI_HIGH_MODEL=gemini-2.5-pro
GEMINI_MID_MODEL=gemini-2.5-flash
GEMINI_LOW_MODEL=gemini-2.5-flash-lite

# Logging Configuration
LOG_LEVEL=TRACE
LOG_TO_CONSOLE=true
LOG_DIR=logs
